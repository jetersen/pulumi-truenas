{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "sdk/go/**",
    "sdk/dotnet/**",
    "sdk/nodejs/**",
    "sdk/python/**"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod",
        "custom.regex"
      ],
      "groupName": "Go dependencies",
      "separateMajorMinor": false,
      "automerge": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "Build tooling",
      "separateMajorMinor": false,
      "automerge": false
    }
  ],
  "ignoreDeps": [
    "github.com/truenas/terraform-provider-truenas/shim"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^provider/shim/shim\\.go$/"
      ],
      "matchStrings": [
        "upstream\\.New\\(\"(?<currentValue>[^\"]+)\"\\)"
      ],
      "depNameTemplate": "github.com/truenas/terraform-provider-truenas",
      "datasourceTemplate": "go",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>[0-9].*)$"
    }
  ],
  "postUpdateOptions": [
    "gomodTidyAll"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "groupName": "Go dependencies",
    "groupSlug": "go-dependencies",
    "separateMajorMinor": false
  }
}
